# Copy this file to .env and fill in your values.

# ---- LLM provider configuration ----
# The app uses an OpenAI-compatible Chat Completions API.
# Leave LLM_API_KEY empty to run in MOCK mode (no external calls, deterministic sample script).

LLM_API_KEY=""
# Base URL of an OpenAI-compatible endpoint.
# OpenAI:        https://api.openai.com/v1
# OpenRouter:    https://openrouter.ai/api/v1
# Groq:          https://api.groq.com/openai/v1
# Local (Ollama):http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds for the LLM call.
LLM_TIMEOUT=120

# ---- Text-to-speech (audio drama rendering) ----
# auto  = "openai" if TTS_API_KEY is set, otherwise free "edge" voices (no key needed)
# openai = real emotional acting via gpt-4o-mini-tts (best quality)
# edge   = free Microsoft neural voices; emotion via rate/pitch/volume
# mock   = offline test tones
TTS_PROVIDER=auto
TTS_API_KEY=""
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_TIMEOUT=120
# Parallel TTS requests while rendering.
TTS_CONCURRENCY=4
AUDIO_OUTPUT_DIR=output/audio
